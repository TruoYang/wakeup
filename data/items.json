 "LORE": [
  [
   "Mẹ",
   "\"Con ơi về chưa? Nhà mình mất điện rồi. Mẹ với em đang ở trong nhà, con đi đường cẩn thận.\""
  ],
  [
   "Vợ",
   "\"Anh đang ở đâu? Em đón được con rồi. Đừng đi đường Hồ, ở đó có con gì to lắm.\""
  ],
  [
   "Nhóm lớp 12A3",
   "\"Ai ở gần hồ không?? Video trên mạng con đấy đi được, nó to hơn cả toà nhà.\""
  ],
  [
   "Sếp",
   "\"Cả công ty nghỉ đến khi có thông báo mới. Ai còn ở văn phòng thì xuống tầng hầm.\""
  ],
  [
   "Số lạ",
   "\"THÔNG BÁO KHẨN: Người dân không di chuyển bằng phương tiện có động cơ. Sinh vật dưới lòng đất phản ứng với tiếng động.\""
  ],
  [
   "Bố",
   "\"Bố đang trên đường về. Nếu bố không về kịp thì con đưa mẹ sang nhà bác nhé.\""
  ],
  [
   "Chị Hà",
   "\"Chị thấy lính ở ngã tư rồi, họ bắn nhưng chẳng ăn thua gì. Đừng đến gần chỗ đấy.\""
  ],
  [
   "Em trai",
   "\"Anh ơi em sợ lắm. Đất cứ rung từng hồi. Anh về nhanh lên.\""
  ]
 ],
